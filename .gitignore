# AutoResearch. The experiment log is per-machine and per-run, and upstream
# keeps it untracked for the same reason: it records a search, not the product.
# run.log is already covered by *.log above.
results.tsv
progress.png

# The bundled Polish host, placed here for DEV RUNS only.
#
# EchoLink.spec maps build/generated/polish-host -> resources/polish-host at
# PACKAGE time, so a shipped install has it and a source checkout never does.
# That meant every measurement taken from source exercised the ollama
# compatibility path while customers get the bundled llama.cpp host - we were
# not measuring what ships. Copying it here closes that gap; it is a 67 MB
# build artefact and must never be committed.
resources/polish-host/

# Same rule as resources/polish-host above, for the copy that was set aside on
# 2026-09-01 rather than deleted. It is the same 67 MB binary under a dated
# name, so it must never be committed either.
resources/polish-host.disabled-*/

# dist-onefile/ holds the single-file ManuscriptV2.exe built from
# EchoLinkOneFile.spec. dist/ is already ignored; this is the same kind of
# output at a different path, and the exe is 330 MB.
dist-onefile/

# A backup written while editing settings.json, not part of the project.
.claude/settings.json.bak
