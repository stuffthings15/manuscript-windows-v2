{
  "manifest_version": 3,
  "name": "Manuscript Windows Version 2",
  "version": "0.1.0",
  "description": "Review local Manuscript corrections in browser text fields.",
  "key": "",
  "permissions": ["nativeMessaging"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["field-security.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["manuscript.svg"],
      "matches": ["<all_urls>"]
    }
  ]
}
