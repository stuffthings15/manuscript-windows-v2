{
  "schema_version": 1,
  "name": "Echo-Link Capstone Gold Corpus",
  "purpose": "Fixed text-level baseline for local cleanup, protected content, and known feature gaps.",
  "default_vocabulary": {
    "echo link": "Echo-Link",
    "open ai": "OpenAI",
    "pie side six": "PySide6",
    "python three point twelve": "Python 3.12",
    "g p t": "GPT",
    "pytest dash q": "pytest -q",
    "echo link underscore plan dot md": "echo_link_plan.md"
  },
  "cases": [
    {
      "id": "prose-01",
      "category": "basic_prose",
      "raw": "hello there",
      "expected": "Hello there.",
      "protected_terms": []
    },
    {
      "id": "prose-02",
      "category": "repetition",
      "raw": "this is is a test",
      "expected": "This is a test.",
      "protected_terms": []
    },
    {
      "id": "prose-03",
      "category": "filler_and_vocabulary",
      "raw": "um echo link comma please start",
      "expected": "Echo-Link, please start.",
      "protected_terms": ["Echo-Link"]
    },
    {
      "id": "question-01",
      "category": "question",
      "raw": "can you open settings",
      "expected": "Can you open settings?",
      "protected_terms": []
    },
    {
      "id": "punctuation-01",
      "category": "spoken_punctuation",
      "raw": "please save this exclamation mark",
      "expected": "Please save this!",
      "protected_terms": []
    },
    {
      "id": "paragraph-01",
      "category": "paragraphs",
      "raw": "first paragraph new paragraph second paragraph",
      "expected": "First paragraph\n\nSecond paragraph.",
      "protected_terms": []
    },
    {
      "id": "correction-01",
