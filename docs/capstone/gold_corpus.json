      "protected_terms": []
    },
    {
      "id": "correction-02",
      "category": "scratch_that",
      "raw": "the first idea is blue scratch that the first idea is green",
      "expected": "The first idea is green.",
      "protected_terms": []
    },
    {
      "id": "protected-01",
      "category": "email",
      "raw": "send this to jane.doe@example.com",
