      "protected_terms": ["https://echo-link.local/docs"]
    },
    {
      "id": "protected-03",
      "category": "windows_path",
      "raw": "open C:\\Work\\EchoLink\\notes.txt",
      "expected": "Open C:\\Work\\EchoLink\\notes.txt.",
      "protected_terms": ["C:\\Work\\EchoLink\\notes.txt"]
    },
    {
      "id": "protected-04",
      "category": "numbers_and_time",
      "raw": "schedule 2:30 pm on 7/18/2026",
